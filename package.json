{
  "name": "beamer-steuerung",
  "version": "2.0.0",
  "description": "Einfache Beamer-Steuerung für die Kirche",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-win": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable",
    "build-mac": "electron-builder --mac",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "extend": "~3.0.0",
    "i18next": "^26.4.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "com.kirche.beamersteuerung",
    "productName": "Beamer Steuerung",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "locales/**/*",
      "index.js",
      "lib/**/*",
      "package.json",
      "!node_modules/i18next/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Ihre Kirche",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Beamer Steuerung"
    },
    "portable": {
      "artifactName": "BeamerSteuerung-Portable.exe"
    }
  },
  "author": {
    "name": "Ihre Kirche",
    "email": "technik@ihre-kirche.de"
  },
  "license": "MIT"
}
